# ============================================================
# Variáveis de ambiente para o deploy do backend (Render + MongoDB Atlas)
# Copie para .env e preencha. NUNCA commite valores reais.
# O application.properties monta a URI a partir destas variáveis.
# ============================================================

# --- MongoDB Atlas (free tier M0) ---
# MONGO_HOST = string de conexão do cluster (ex.: cluster0.xxxxx.mongodb.net)
MONGO_HOST=<CLUSTER>.mongodb.net
MONGO_PORT=27017
MONGO_DATABASE=saude_monitor
MONGO_AUTH_DB=admin
MONGO_USER=<USUARIO_ATLAS>
MONGO_PASSWORD=<SENHA_ATLAS>

# --- JWT (obrigatório em produção, >= 32 bytes) ---
JWT_SECRET=<GERAR_CHAVE_ALEATORIA_32_BYTES>

# --- Seed de usuário ADMIN inicial ---
# Desligado por padrão (SEG-07). Para criar o admin no primeiro boot:
# APP_SEEDADMIN_ENABLED=true e senha com pelo menos 12 caracteres.
APP_SEEDADMIN_ENABLED=false
ADMIN_EMAIL=<EMAIL_ADMIN>
ADMIN_SENHA=<TROCAR_SENHA_ADMIN>

# --- Seed de estabelecimentos (opcional em produção) ---
# app.seed.enabled=true
# app.seed.modo=skip-if-not-empty

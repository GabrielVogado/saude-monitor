# Copie para .env NA VM (nunca versione o .env — este repositório é público).
#   cp .env.example .env && nano .env && chmod 600 .env

# --- Rede ---
DOMINIO=api-dev.seu-dominio.com.br
EMAIL_TLS=seu-email-de-contato@exemplo.com

# --- Imagem ---
TAG_IMAGEM=dev-arm64

# --- MongoDB Atlas (sa-east-1) ---
# Use a connection string SRV do cluster; ela tem prioridade sobre MONGO_HOST/PORT
# no application.properties. Não esqueça o nome do banco antes do "?".
MONGO_URI=mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/saude_monitor_dev?retryWrites=true&w=majority

# --- Aplicação ---
# JWT_SECRET: gere com `openssl rand -base64 48`. Cada ambiente tem o seu.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_SENHA=
APP_SEED_ENABLED=false
